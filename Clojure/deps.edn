{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/test.check {:mvn/version "1.1.3"}}
 :aliases
 {:dev {:extra-paths ["dev"]
        :jvm-opts ["-Djdk.attach.allowAttachSelf"]}
  :test-out {:extra-paths ["test-out"]}
  :test {:extra-paths ["test" "test-out"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      metosin/malli {:mvn/version "0.20.3"}}
         :main-opts ["-m" "kaocha.runner"]}
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          :ns-default build
          :build/project {:lib io.github.conao3/lean-clj
                          :version "0.2.0"
                          :description "Write and prove functions in Lean 4, run them on the JVM from Clojure."
                          :url "https://github.com/conao3/lean-clj"
                          :license "Apache-2.0"}}}}
