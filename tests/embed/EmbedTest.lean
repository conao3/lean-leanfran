import Leanfran.Embed

open Lean System Leanfran.Embed

def fakeLakefile : String :=
  "name = \"fake\"\n" ++
  "defaultTargets = [\"FakeBlocks\"]\n" ++
  "\n[[lean_lib]]\nname = \"FakeBlocks\"\nglobs = [\"FakeBlocks.+\"]\n" ++
  "\n[[lean_lib]]\nname = \"FakeLib\"\n" ++
  "\n[[lean_lib]]\nname = \"FakeModel\"\nglobs = [\"FakeModel.+\"]\n" ++
  "\n[[lean_lib]]\nname = \"Proofs\"\nglobs = [\"Proofs.+\"]\n"

def launch : Host.Launch := fun _ => do
  match ← IO.getEnv "LEANFRAN_FAKE_PACKAGE" with
  | some script => return .ok ("bash", #[script])
  | none => return .error (.environment "the fake language package is not installed; set LEANFRAN_FAKE_PACKAGE")

def projectRoot (dir : FilePath) : IO (Except Failure FilePath) := do
  match ← (IO.FS.realPath dir).toBaseIO with
  | .ok root => return .ok root
  | .error error => return .error (.content s!"{dir}: {error}")

def extraOutputs (_ : Context) (_ : Unit) (_ : Scan) (summaries : Summaries) :
    IO (Except Failure (Array ProjectFile)) :=
  return .ok #[{path := "fake_extra.txt", text := s!"// generated by fake\n{summaries.size} blocks\n"}]

def backend (lang : String) (unit : ColumnUnit) : Backend := {
  lang, version := "0", generatorVersion := "1", dirOption := "--dir", dirRequired := false, State := Unit
  root := projectRoot, scan := Host.scan launch "0" "1", translate := Host.translate launch "0" "1"
  lakefile := fakeLakefile, supportFiles := #[{path := "FakeLib.lean", text := "def fakeLib : Nat := 1\n"}]
  ownedDirs := #["FakeBlocks"], verificationDir := ".", generatedHeaders := #["// generated by fake"]
  columnUnit := unit, job := Batch.withOutput, generateArgs := #[]
  generate := fun ctx _ _ blocks => Batch.run Batch.withOutput #[] ctx blocks
  supportModules := fun _ _ => #[], extraOutputs}

def generateBatch (file : String) : IO UInt32 := do
  let jobs ← IO.ofExcept (Json.parse (← IO.FS.readFile file) >>= (·.getArr?))
  let mut results := #[]
  for job in jobs do
    let module := (job.getObjValAs? String "module").toOption.getD ""
    if let .ok message := job.getObjValAs? String "fail" then
      results := results.push (Json.mkObj [("module", toJson module), ("error", toJson message), ("code", toJson (254 : Nat))])
      continue
    let dir : FilePath := match job.getObjValAs? String "output_dir", job.getObjValAs? String "output_file" with
      | .ok dir, _ => dir
      | _, .ok file => (FilePath.mk file).parent.getD "."
      | _, _ => "."
    for (path, text) in objFields (job.getObjValD "files") do
      let target := dir / path
      if let some parent := target.parent then IO.FS.createDirAll parent
      IO.FS.writeFile target (text.getStr?.toOption.getD "")
    results := results.push (Json.mkObj [("module", toJson module), ("skipped", Json.arr #[])])
  IO.println (Json.arr results).compress
  return 0

def obligationsCheck (file : String) : IO UInt32 := do
  let refs ← IO.ofExcept (Json.parse (← IO.FS.readFile file) >>= (·.getArr?))
  let results := refs.map fun ref =>
    let label := (ref.getObjValAs? String "label").toOption.getD ""
    let status := if label == "missing" then "missing" else "proved"
    Json.mkObj [("model", ref.getObjValD "model"), ("label", toJson label), ("status", toJson status),
      ("axioms", toJson #["propext"])]
  IO.println (Json.arr results).compress
  return 0

def main (args : List String) : IO UInt32 := do
  let "--lang" :: lang :: rest := args | IO.eprintln "usage: leanfran-embed-test --lang <fake-byte|fake-utf16> ..."; return 252
  let unit ← match lang with
    | "fake-byte" => pure ColumnUnit.byte
    | "fake-utf16" => pure ColumnUnit.utf16
    | _ => IO.eprintln s!"unknown language {lang}"; return 252
  match rest with
  | "module" :: "generate" :: "--batch" :: file :: _ => generateBatch file
  | "obligations" :: "check" :: tail =>
    let some file := (tail.dropWhile (· != "--obligations")).drop 1 |>.head? | return 252
    obligationsCheck file
  | command :: tail => run (backend lang unit) command tail
  | [] => return 252
