{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "leanfran": ["./src/index.ts"],
      "leanfran/runtime": ["./src/runtime/index.ts"],
      "leanfran/schema": ["./src/schema/index.ts"],
      "leanfran/verify": ["./src/verify/index.ts"]
    }
  },
  "include": ["src", "test", "test-out", "samples", "scripts", "vite.config.ts"]
}
