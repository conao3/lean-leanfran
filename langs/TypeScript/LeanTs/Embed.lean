import Leanfran.Embed

open Lean System Leanfran.Embed

namespace LeanTs.Embed

def tsLibSource : String := include_str "../src/lean/LeanTsLib/Ts.lean"

def lakefile : String :=
  "name = \"leanfran-workspace\"\n" ++
  "defaultTargets = [\"LeanTsModels\", \"LeanTsEmbed\", \"LeanTsCsimp\"]\n" ++
  "\n[[lean_lib]]\nname = \"LeanTsModels\"\n" ++
  "\n[[lean_lib]]\nname = \"LeanTsEmbed\"\n" ++
  "\n[[lean_lib]]\nname = \"LeanTsCsimp\"\n" ++
  "\n[[lean_lib]]\nname = \"LeanTsLib\"\n" ++
  "\n[[lean_lib]]\nname = \"LeanTsModel\"\n" ++
  "\n[[lean_lib]]\nname = \"Proofs\"\nglobs = [\"Proofs.+\"]\n"

def launch : Host.Launch := fun ctx => do
  let cli := ctx.root / "node_modules" / "leanfran" / "dist" / "cli.js"
  unless ← cli.pathExists do
    return .error (.environment
      s!"leanfran --lang typescript: cannot find the TypeScript package `leanfran` in {ctx.root / "node_modules"}; run `npm install leanfran` or `pnpm add leanfran` in {ctx.root}")
  return .ok ("node", #["--", cli.toString])

def projectRoot (dir : FilePath) : IO (Except Failure FilePath) := do
  match ← (IO.FS.realPath dir).toBaseIO with
  | .error error => return .error (.content s!"{dir}: {error}")
  | .ok root =>
    unless ← root.isDir do return .error (.content s!"{dir} is not a directory")
    return .ok root

structure Csimp where
  spec : String
  module : String
  modes : Array String
  path : String
  ns : String
  name : String

def Csimp.ofData (data : Json) : Option Csimp := do
  let c ← (data.getObjVal? "csimp").toOption
  let field := fun (key : String) => (c.getObjValAs? String key).toOption
  return {
    spec := ← field "spec", module := ← field "module", path := ← field "path"
    ns := ← field "namespace", name := ← field "name"
    modes := ← (c.getObjValAs? (Array String) "modes").toOption}

def supportModules (lock : LockSection) (scan : Scan) : Array WorkspaceFile := Id.run do
  let saved : Std.HashMap String LockFunction := .ofList (lock.functions.toList.map fun f => (f.id, f))
  let mut files : Array (String × String × Array String × Array String) := #[]
  for f in scan.functions do
    let some l := saved[f.id]? | continue
    unless l.hash == f.hash && l.obligations.any (fun o => o.label == "refines" && o.status == "proved") do continue
    let some c := Csimp.ofData l.data | continue
    let parts := f.id.splitOn ":"
    let module := ":".intercalate parts.dropLast
    let fn := parts.getLast!
    let target := s!"ts:{module}#{fn}({",".intercalate c.modes.toList})"
    let text := s!"@[extern {(Json.str target).compress}]\ndef {c.name} := @_root_.{c.spec}\n\n" ++
      s!"@[csimp] theorem {c.name}.csimp : @_root_.{c.spec} = @{c.name} := rfl"
    match files.findIdx? (·.1 == c.path) with
    | some i => files := files.modify i fun (p, ns, imports, defs) =>
        (p, ns, if imports.contains c.module then imports else imports.push c.module, defs.push text)
    | none => files := files.push (c.path, c.ns, #[c.module], #[text])
  let modules := files.map fun (path, ns, imports, defs) => ({
    path, text := String.join ((imports.qsort (· < ·)).toList.map (s!"import {·}\n")) ++
      s!"\nnamespace {ns}\n\n{"\n\n".intercalate defs.toList}\n\nend {ns}\n"} : WorkspaceFile)
  let root := String.join (files.toList.map fun (_, ns, _, _) => s!"import {ns}\n")
  return modules.push {path := "LeanTsCsimp.lean", text := if root.isEmpty then "\n" else root}

def backend (version generatorVersion : String) : Backend := {
  lang := "typescript", version, generatorVersion, dirOption := "--package", dirRequired := true, State := Unit
  root := projectRoot
  scan := Host.scan launch version generatorVersion
  translate := Host.translate launch version generatorVersion
  lakefile
  supportFiles := #[{path := "LeanTsLib/Ts.lean", text := tsLibSource}, {path := "LeanTsLib.lean", text := "import LeanTsLib.Ts\n"}]
  ownedDirs := #["LeanTsEmbed", "LeanTsModels", "LeanTsCsimp"], verificationDir := "."
  generatedHeaders := #["// Generated by leanfran-typescript (generator ", "// Generated by leanfran sync from "]
  columnUnit := .utf16, job := Batch.withOutput, generateArgs := #["--import", "LeanTsCsimp"]
  generate := fun ctx _ _ blocks => Batch.run Batch.withOutput #["--import", "LeanTsCsimp"] ctx blocks
  supportModules, extraOutputs := fun _ _ _ _ => pure (.ok #[])}

end LeanTs.Embed
