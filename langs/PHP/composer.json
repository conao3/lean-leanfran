{
    "name": "conao3/leanfran",
    "description": "PHP runtime for Lean 4 code generated by leanfran",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.4",
        "php-64bit": "*",
        "ext-gmp": "*",
        "ext-tokenizer": "*"
    },
    "bin": ["bin/leanfran"],
    "autoload": {
        "psr-4": {
            "Conao3\\Leanfran\\": "src/"
        },
        "files": [
            "src/Runtime/object.php",
            "src/Runtime/array.php",
            "src/Runtime/string.php",
            "src/Runtime/closure.php",
            "src/Runtime/thunk.php",
            "src/Runtime/io.php",
            "src/Runtime/nat.php",
            "src/Runtime/int.php",
            "src/Runtime/uint.php",
            "src/Runtime/sint.php",
            "src/Runtime/float.php",
            "src/Runtime/ioerror.php",
            "src/Runtime/fs.php",
            "src/Runtime/process.php",
            "src/Runtime/time.php",
            "src/Runtime/bytearray.php",
            "src/Runtime/misc.php",
            "src/Runtime/task.php"
        ]
    },
    "require-dev": {
        "cuyz/valinor": "^2.8"
    },
    "suggest": {
        "cuyz/valinor": "Map data to generated public types and collect Lean validation errors."
    }
}
