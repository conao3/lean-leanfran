{
    "name": "leanfran/embed-fixture",
    "require": {
        "conao3/leanfran": "*"
    },
    "repositories": [
        {"type": "path", "url": "../../..", "options": {"symlink": true, "versions": {"conao3/leanfran": "0.6.0"}}},
        {"packagist.org": false}
    ],
    "autoload": {
        "psr-4": {"App\\": ["src/", "optional/"]}
