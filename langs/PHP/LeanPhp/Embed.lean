import Leanfran.Embed

open Lean System Leanfran.Embed

namespace LeanPhp.Embed

def phpLibSource : String := include_str "../src/lean/LeanPhpLib/Php.lean"

def lakefile : String :=
  "name = \"leanfran-php-workspace\"\n" ++
  "defaultTargets = [\"LeanPhpEmbed\", \"LeanPhpModels\"]\n" ++
  "\n[[lean_lib]]\nname = \"LeanPhpEmbed\"\n" ++
  "\n[[lean_lib]]\nname = \"LeanPhpModels\"\n" ++
  "\n[[lean_lib]]\nname = \"LeanPhpLib\"\nsrcDir = \"verification\"\nglobs = [\"LeanPhpLib.+\"]\n" ++
  "\n[[lean_lib]]\nname = \"LeanPhpModel\"\nsrcDir = \"verification\"\nglobs = [\"LeanPhpModel\", \"LeanPhpModel.+\"]\n" ++
  "\n[[lean_lib]]\nname = \"Proofs\"\nsrcDir = \"verification\"\nglobs = [\"Proofs.+\"]\n"

def launch : Host.Launch := fun ctx => do
  let cli := ctx.root / "vendor" / "conao3" / "leanfran" / "bin" / "leanfran"
  unless ← cli.pathExists do
    return .error (.environment
      s!"cannot find the PHP package conao3/leanfran in {ctx.root / "vendor"}; run `composer require conao3/leanfran` in {ctx.root}")
  return .ok ("php", #[cli.toString])

def projectRoot (dir : FilePath) : IO (Except Failure FilePath) := do
  match ← (IO.FS.realPath dir).toBaseIO with
  | .ok root => return .ok root
  | .error error => return .error (.content s!"{dir}: {error}")

def backend (version generatorVersion : String) : Backend := {
  lang := "php", version, generatorVersion, dirOption := "--package", dirRequired := false, State := Unit
  root := projectRoot
  scan := Host.scan launch version generatorVersion
  translate := Host.translate launch version generatorVersion
  lakefile, supportFiles := #[{path := "verification/LeanPhpLib/Php.lean", text := phpLibSource}]
  ownedDirs := #["LeanPhpEmbed"], verificationDir := "verification"
  generatedHeaders := #["<?php // Generated by leanfran-php "]
  columnUnit := .codePoint, job := Batch.withOutput, generateArgs := #[]
  generate := fun ctx _ _ blocks => Batch.run Batch.withOutput #[] ctx blocks
  supportModules := fun _ _ => #[], extraOutputs := fun _ _ _ _ => pure (.ok #[])}

end LeanPhp.Embed
