import Leanfran.Embed

open Lean System Leanfran.Embed

namespace LeanPython.Embed

def pyLibSource : String := include_str "../src/leanfran/lean/LeanPythonLib/Py.lean"

def lakefile : String :=
  "name = \"leanfran-python-workspace\"\n" ++
  "defaultTargets = [\"LeanPythonEmbed\", \"LeanPythonModels\"]\n" ++
  "\n[[lean_lib]]\nname = \"LeanPythonEmbed\"\n" ++
  "\n[[lean_lib]]\nname = \"LeanPythonModels\"\n" ++
  "\n[[lean_lib]]\nname = \"LeanPythonLib\"\n" ++
  "\n[[lean_lib]]\nname = \"LeanPythonModel\"\n" ++
  "\n[[lean_lib]]\nname = \"Proofs\"\nglobs = [\"Proofs.+\"]\n"

def python : String := "python3"

def launch : Host.Launch := fun ctx => do
  let install := s!"run leanfran in the environment of the project, for example `uv run leanfran --lang python sync --package <dir>`"
  let probe : IO.Process.SpawnArgs := {
    cmd := python, args := #["-c", "import leanfran.cli"], cwd := some ctx.root
    env := #[("PYTHONDONTWRITEBYTECODE", some "1")]}
  match ← (IO.Process.output probe).toBaseIO with
  | .error _ => return .error (.environment s!"leanfran --lang python: `{python}` is not on PATH; {install}")
  | .ok out =>
    unless out.exitCode == 0 do
      return .error (.environment s!"leanfran --lang python: {python} cannot import the Python package `leanfran`; {install}")
    return .ok (python, #["-m", "leanfran.cli"])

partial def findProject (dir : FilePath) : IO (Option FilePath) := do
  if ← (dir / "pyproject.toml").pathExists then return some dir
  match dir.parent with
  | some parent => if parent == dir then return none else findProject parent
  | none => return none

def projectRoot (dir : FilePath) : IO (Except Failure FilePath) := do
  let start ← match ← (IO.FS.realPath dir).toBaseIO with
    | .ok start => pure start
    | .error _ => return .error (.content s!"{dir}: no such Python package directory")
  unless ← start.isDir do return .error (.content s!"{dir}: not a Python package directory")
  match ← findProject start with
  | some root => return .ok root
  | none => return .ok (start.parent.getD start)

def backend (version generatorVersion : String) : Backend := {
  lang := "python", version, generatorVersion, dirOption := "--package", dirRequired := true, State := Unit
  root := projectRoot
  scan := Host.scan launch version generatorVersion
  translate := Host.translate launch version generatorVersion
  lakefile
  supportFiles := #[{path := "LeanPythonLib.lean", text := "import LeanPythonLib.Py\n"},
    {path := "LeanPythonLib/Py.lean", text := pyLibSource}]
  ownedDirs := #["LeanPythonEmbed", "LeanPythonModels"], verificationDir := "."
  generatedHeaders := #["# Generated by leanfran-python "]
  columnUnit := .codePoint, job := Batch.withOutput, generateArgs := #[]
  generate := fun ctx _ _ blocks => Batch.run Batch.withOutput #[] ctx blocks
  supportModules := fun _ _ => #[], extraOutputs := fun _ _ _ _ => pure (.ok #[])}

end LeanPython.Embed
